import "os"

id "test/cmaketest"

fromVer "1.0.0"

onBuild ctx => {
	installDir := ctx.outputDir

	c := cmake.new(ctx.SourceDir, ctx.SourceDir+"/_build", installDir)
	c.buildType "Release"
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"

	c.configure
	c.build
	c.install

	ctx.setMetadata "-lcmtadd"
}

onTest ctx => {
	installDir := ctx.outputDir

	// Build the test program in its own tree so onTest works identically
	// on cache hit (where onBuild was skipped and no _build dir exists)
	// and on cache miss (where onBuild just populated _build).
	testSrc := ctx.SourceDir + "/tests"
	testBuild := ctx.SourceDir + "/_testbuild"

	tc := cmake.new(testSrc, testBuild, testBuild+"/_out")
	tc.buildType "Release"
	tc.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	tc.use installDir

	tc.configure
	tc.build

	// Run the freshly-built test binary. A non-zero exit code surfaces
	// via lastErr and fails onTest.
	exec testBuild + "/cmtadd_check"
	if lastErr != nil {
		panic lastErr
	}

	os.writeFile(installDir+"/ontest.stamp", []byte("cmtadd_check passed"), 0o644)!
}
