id "test/depresult"

fromVer "1.0.0"

onRequire (proj, deps) => {
	deps.require "test/liba", "1.0.0"
}

onBuild ctx => {
	if len(ctx.Proj.Deps) > 0 {
		result, ok := ctx.buildResult(ctx.Proj.Deps[0])
		if ok {
			ctx.setMetadata result.metadata() + " -lDR"
			return
		}
	}
	ctx.setMetadata "-lDR_NO_DEP"
}
